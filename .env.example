# ------------------------------------------------------------------
# Copy this file to `.env` and adjust the values if you want to
# override the defaults.  Everything below already has a working
# default in docker-compose.yml, so a fresh `docker compose up`
# works even if you do NOT create a .env file.
# ------------------------------------------------------------------

# MySQL application account (created automatically on first start)
MYSQL_USER=todo_user
MYSQL_PASSWORD=SuperSecurePassword
MYSQL_DATABASE=todo_site
